<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/ivThumb"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/app_name"
        android:scaleType="centerCrop"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/videoBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        android:background="#99000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:paddingVertical="2dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/ivThumb"
        app:layout_constraintStart_toStartOf="@id/ivThumb">

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:contentDescription="@string/play"
            android:src="@drawable/ic_play_arrow"
            app:tint="@android:color/white" />

        <TextView
            android:id="@+id/tvDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:textColor="@android:color/white"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 标签浮层：覆盖在缩略图上，所有标签由 ChipGroup 自动换行；
         不担心遮挡图片，标签多时允许向下延伸 -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/tagRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="4dp"
        android:visibility="gone"
        app:chipSpacingHorizontal="2dp"
        app:chipSpacingVertical="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/ivThumb"
        app:layout_constraintStart_toStartOf="@id/ivThumb"
        app:layout_constraintTop_toTopOf="@id/ivThumb"
        app:singleLine="false"
        app:singleSelection="false" />

    <!-- 多选角标：右上角，蓝色圆底 + 白勾 -->
    <ImageView
        android:id="@+id/ivSelection"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_margin="6dp"
        android:background="@drawable/bg_selection_badge"
        android:contentDescription="@string/selected"
        android:padding="3dp"
        android:src="@drawable/ic_check"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/ivThumb"
        app:layout_constraintTop_toTopOf="@id/ivThumb" />

</androidx.constraintlayout.widget.ConstraintLayout>
